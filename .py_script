# November 2025
#
# biosample_survey_scraper.py
#
# Description:
#   Standalone Python script that reads a text file containing
#   NCBI BioSample IDs, downloads each sample’s survey page,
#   extracts the response to one target question "dominant hand",
#   and writes a clean CSV report.
#
# Requirements: requests, beautifulsoup4, pandas
#
# Usage:
#   python biosample_survey_scraper.py input_ids.txt output.csv
#
# Input file format:
#   One BioSample ID per line:
#      SAMN00000001
#      SAMN00000002
#       ...
# --------------------------------------------------------------

import sys
import requests
import pandas as pd
from bs4 import BeautifulSoup
from time import sleep

# -------------------------------
# CONFIG
# -------------------------------
BASE_URL = "https://www.ncbi.nlm.nih.gov/biosample/?term="
TARGET_QUESTION = "dominant hand"
REQUEST_DELAY = 0.3  # seconds between requests to avoid hammering NCBI


# --------------------------------------------------------------
def read_ids(path):
    """Read text file and return list of BioSample IDs."""
    with open(path, "r") as f:
        ids = [line.strip() for line in f if line.strip() != ""]
    return ids


# --------------------------------------------------------------
def fetch_survey_table(sample_id):
    """Download and parse the first table from a BioSample record."""
    url = BASE_URL + sample_id
    try:
        r = requests.get(url, timeout=20)
        r.raise_for_status()
    except Exception as e:
        print(f"[ERROR] Failed to fetch {sample_id}: {e}")
        return None

    soup = BeautifulSoup(r.text, "html.parser")
    table = soup.find("table")

    if table is None:
        print(f"[WARNING] No table found for {sample_id}")
        return None

    rows = []
    for tr in table.find_all("tr"):
        cols = [td.get_text(strip=True) for td in tr.find_all(["td", "th"])]
        rows.append(cols)

    # Convert uneven rows into a DataFrame
    return pd.DataFrame(rows)


# --------------------------------------------------------------
def extract_response(df):
    """Find row where column 0 == TARGET_QUESTION and return the value."""
    if df is None or df.empty:
        return None

    # The first column of the R table was X1, so column 0 here
    for _, row in df.iterrows():
        if row.iloc[0].lower() == TARGET_QUESTION.lower():
            return row.iloc[1] if len(row) > 1 else None

    return None


# --------------------------------------------------------------
def main(infile, outfile):
    ids = read_ids(infile)
    print(f"[INFO] Loaded {len(ids)} BioSample IDs.")

    results = []

    for sample_id in ids:
        print(f"[INFO] Processing: {sample_id}")
        table = fetch_survey_table(sample_id)
        response = extract_response(table)
        results.append({"ID": sample_id, "Response": response})
        sleep(REQUEST_DELAY)  # be polite to NCBI servers

    df = pd.DataFrame(results)
    df.to_csv(outfile, index=False)

    print(f"[SUCCESS] Saved CSV: {outfile}")


# --------------------------------------------------------------
if __name__ == "__main__":
    if len(sys.argv) != 3:
        print("Usage: python biosample_survey_scraper.py input_ids.txt output.csv")
        sys.exit(1)

    main(sys.argv[1], sys.argv[2])
